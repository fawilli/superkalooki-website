# Public Sanity config (safe to expose in the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=z4m7bqdz
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-07-19

# Server-only — Viewer token for Draft Mode/preview (optional for v1 public reads)
SANITY_API_READ_TOKEN=

# Server-only — shared secret for Sanity → /api/revalidate webhook
SANITY_REVALIDATE_SECRET=

# Canonical site URL
# Production: https://superkalooki.com
# Preview: your *.vercel.app URL
# Development: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://superkalooki.com
